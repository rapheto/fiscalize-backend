# App
# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the Express server listens on (Railway sets this automatically in production)
PORT=3000

# Database
# PostgreSQL connection string used by Prisma and the pg pool
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=your-strong-secret-here

# Access JWT lifetime (keep short: 15m to 60m)
JWT_EXPIRATION=30m

# MFA/OTP
# Created by AI.
# Updated by AI.
# Único transporte de e-mail do projeto: SMTP do Gmail.
# GMAIL_APP_PASSWORD é uma senha de app de 16 caracteres; exige 2FA ativa na conta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Remetente dos códigos. Se vazio, usa GMAIL_USER. Em produção, não pode ser *.local.
OTP_EMAIL_FROM=

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Redis
# Redis connection URL for metrics cache (optional — app falls back if unavailable)
REDIS_URL=redis://default:password@host:6379

# CORS
# Comma-separated list of allowed frontend origins (required in production)
# Example: https://your-app.vercel.app,https://www.your-domain.com
ALLOWED_ORIGINS=https://your-app.vercel.app

# Cron
# Cron expression for the metrics consolidation job (default: every hour)
CRON_METRICS_SCHEDULE=0 * * * *

# Seed (optional — used only when running prisma db seed)
# Initial admin user created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_NAME=Administrador

# Local development only
# Optional extra origin for CORS during local development (also allows localhost:3000 and :3001)
FRONTEND_URL=http://localhost:3001
